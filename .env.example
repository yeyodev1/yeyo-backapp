# Plantilla — copiar a .env y rellenar. El .env real nunca se versiona.

# ─── Base ─────────────────────────────────────────────────────────────
DB_URI=mongodb://localhost:27017/yeyo
PORT=8100
JWT_SECRET=cambiame_por_algo_largo
SLACK_ERROR_WEBHOOK=

# Orígenes CORS extra (producción, túneles), separados por coma
CORS_ORIGINS=
FRONTEND_URL=http://localhost:5173

# ─── Admin ────────────────────────────────────────────────────────────
# Cuenta de administración que se siembra al arrancar si no existe.
# Sin ADMIN_PASSWORD no se crea nada.
ADMIN_EMAIL=admin@yeyo.dev
ADMIN_PASSWORD=
ADMIN_NAME=Administración

# ─── Correo (Resend) ──────────────────────────────────────────────────
# Sin la key el API funciona igual, pero no envía correos.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Yeyo <onboarding@resend.dev>

# ─── Avisos de solicitudes ───────────────────────────────────────────
# Bot de @BotFather y tu chat id (escríbele al bot y abre getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CONTACT_WHATSAPP=593963681303
CONTACT_INSTAGRAM=yeyo.dev
# Horas que esperan las solicitudes sin atender antes del correo de seguimiento
FOLLOW_UP_AFTER_HOURS=48
# Protege /api/cron/* (Vercel Cron lo manda como Bearer)
CRON_SECRET=
CONTACT_EMAIL=me@yeyo.dev
# URL pública de esta API (ej. https://yeyo-backapp.vercel.app) para el botón de Telegram
API_PUBLIC_URL=
